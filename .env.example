# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional: Custom Production Google AdMob Keys
# If left blank, official Google sample test ad units are used automatically.
# ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
# ADMOB_BANNER_AD_UNIT_ID=ca-app-pub-3940256099942544/6300978111
# ADMOB_ADAPTIVE_BANNER_AD_UNIT_ID=ca-app-pub-3940256099942544/9214589741
# ADMOB_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-3940256099942544/1033173712
# ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917
# ADMOB_REWARDED_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-3940256099942544/5354046379
